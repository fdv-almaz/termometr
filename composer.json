{
    "name": "fdv/termometr",
    "description": "IoT temperature monitoring system with Arduino and web API",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "phpunit/php-code-coverage": "^9.2"
    },
    "autoload": {
        "psr-4": {
            "Termometr\\": "meteo/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage/",
        "test:api": "phpunit tests/unit/Api/",
        "test:database": "phpunit tests/unit/Database/",
        "test:integration": "phpunit tests/unit/Integration/",
        "test:verbose": "phpunit --verbose"
    }
}
